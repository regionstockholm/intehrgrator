                      "name": "codeLine1",
                      "fill": "#5C7C8A",
                      "content": "import { Composition, Observation }",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "wWlaZ",
                      "name": "codeLine2",
                      "fill": "#5C7C8A",
                      "content": "  from 'ehrtslib';",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "MwCki",
                      "name": "codeLine3",
                      "fill": "#F5F3EF",
                      "content": " ",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "drD9T",
                      "name": "codeLine4",
                      "fill": "#F5F3EF",
                      "content": "export function mapVitals(src: any) {",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "0Ir6J",
                      "name": "codeLine5",
                      "fill": "#F5F3EF",
                      "content": "  const comp = new Composition({",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "xgiFD",
                      "name": "codeLine6",
                      "fill": "#C05A3C",
                      "content": "    name: 'vitals_encounter',",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "tf3AF",
                      "name": "codeLine7",
                      "fill": "#F5F3EF",
                      "content": "    content: [",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "niSWi",
                      "name": "codeLine8",
                      "fill": "#F5F3EF",
                      "content": "      new Observation({",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "tAETJ",
                      "name": "codeLine9",
                      "fill": "#E87722",
                      "content": "        systolic: src.vitals[0].systolic,",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "hBp7j",
                      "name": "codeLine10",
                      "fill": "#888888",
                      "content": "        diastolic: src.vitals[0].diastolic",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "mpfXx",
                      "name": "codeLine11",
                      "fill": "#F5F3EF",
                      "content": "      })",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "1nuOi",
                      "name": "codeLine12",
                      "fill": "#F5F3EF",
                      "content": "    ]",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "cNRMS",
                      "name": "codeLine13",
                      "fill": "#F5F3EF",
                      "content": "  });",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "NDxyo",
                      "name": "codeLine14",
                      "fill": "#F5F3EF",
                      "content": "  return comp;",
                      "fontFamily": "JetBrains Mono, monospace",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
