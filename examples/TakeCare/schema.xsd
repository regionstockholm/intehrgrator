<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="ProfdocHISMessage">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="PatId" type="xs:string" />
        <xs:element name="UserId" type="xs:string" />
        <xs:element name="EventTime" type="xs:unsignedLong" />
        <xs:element name="Signer" type="xs:string" />
        <xs:element name="Signed" type="xs:integer" minOccurs="0" minInclusive="0" maxInclusive="1" />
        <xs:element name="TemplateId" type="xs:integer" />
        <xs:element name="TemplateType" type="xs:integer" />

        <xs:element name="UUID" type="xs:string" minOccurs="0" maxOccurs="1" />
        <xs:element name="Keywords">
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" maxOccurs="1" name="TextKeywords">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="unbounded" name="TextKeyWord">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="TermId" type="xs:int" />
                          <xs:element name="Note" type="xs:string" />
                          <xs:element name="ValueTerms" minOccurs="0" maxOccurs="1">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="ValueTermId" type="xs:unsignedInt" minOccurs="1" maxOccurs="unbounded" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="NumericKeywords">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="unbounded" name="NumericKeyword">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="TermId" type="xs:int" />
                          <xs:element name="Note" type="xs:string" />
                          <xs:element name="ValueTerms" minOccurs="0" maxOccurs="1">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="ValueTermId" type="xs:unsignedInt" minOccurs="1" maxOccurs="unbounded" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="DatetimeKeywords">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="unbounded" name="DatetimeKeyword">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="TermId" type="xs:int" />
                          <xs:element name="Note" type="xs:string" />
                          <xs:element name="ValueTerms" minOccurs="0" maxOccurs="1">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="ValueTermId" type="xs:unsignedInt" minOccurs="1" maxOccurs="unbounded" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="UserKeywords">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="unbounded" name="UserKeyword">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="TermId" type="xs:int" />
                          <xs:element name="Note" type="xs:string" />
                          <xs:element name="ValueTerms" minOccurs="0" maxOccurs="1">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="ValueTermId" type="xs:unsignedInt" minOccurs="1" maxOccurs="unbounded" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute fixed="Request" name="MsgType" type="xs:string" />
      <xs:attribute name="Time" type="xs:unsignedLong" use="required" />
      <xs:attribute name="InvokingSystem" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>


